<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    VIEW: the layout of the main window.
    BorderPane regions:  top = MenuBar + ToolBar,  center = the 3 columns,  bottom = status bar.
    fx:id      -> injected into the matching @FXML field in KanbanController
    onAction   -> calls the matching @FXML method in KanbanController
-->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.nye.kanban.KanbanController"
            prefWidth="1000" prefHeight="640" styleClass="board-root">

    <!-- ===== TOP: menus + toolbar ===== -->
    <top>
        <VBox>
            <MenuBar>
                <Menu text="_File">
                    <MenuItem text="_New Task" accelerator="Shortcut+N" onAction="#onNewTask"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="E_xit" onAction="#onExit"/>
                </Menu>
                <Menu text="_Edit">
                    <MenuItem fx:id="editMenuItem" text="_Edit Task" accelerator="Shortcut+E" onAction="#onEditTask"/>
                    <MenuItem fx:id="deleteMenuItem" text="_Delete Task" accelerator="Delete" onAction="#onDeleteTask"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="moveLeftMenuItem" text="Move _Left" accelerator="Shortcut+Left" onAction="#onMoveLeft"/>
                    <MenuItem fx:id="moveRightMenuItem" text="Move _Right" accelerator="Shortcut+Right" onAction="#onMoveRight"/>
                </Menu>
                <Menu text="_Help">
                    <MenuItem text="_About" onAction="#onAbout"/>
                </Menu>
            </MenuBar>

            <ToolBar>
                <Button text="+ New Task" onAction="#onNewTask" styleClass="primary-button"/>
                <Button fx:id="editButton" text="Edit" onAction="#onEditTask"/>
                <Button fx:id="deleteButton" text="Delete" onAction="#onDeleteTask"/>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="moveLeftButton" text="◀ Move Left" onAction="#onMoveLeft"/>
                <Button fx:id="moveRightButton" text="Move Right ▶" onAction="#onMoveRight"/>
            </ToolBar>
        </VBox>
    </top>

    <!-- ===== CENTER: three equal columns ===== -->
    <center>
        <HBox spacing="16">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>

            <!-- Column 1: To Do -->
            <VBox styleClass="column" HBox.hgrow="ALWAYS" prefWidth="300">
                <HBox styleClass="column-header" spacing="8">
                    <Label text="To Do" styleClass="column-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="todoCount" styleClass="count-badge"/>
                </HBox>
                <ListView fx:id="todoList" styleClass="task-list" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Column 2: In Progress -->
            <VBox styleClass="column" HBox.hgrow="ALWAYS" prefWidth="300">
                <HBox styleClass="column-header" spacing="8">
                    <Label text="In Progress" styleClass="column-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="inProgressCount" styleClass="count-badge"/>
                </HBox>
                <ListView fx:id="inProgressList" styleClass="task-list" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Column 3: Done -->
            <VBox styleClass="column" HBox.hgrow="ALWAYS" prefWidth="300">
                <HBox styleClass="column-header" spacing="8">
                    <Label text="Done" styleClass="column-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="doneCount" styleClass="count-badge"/>
                </HBox>
                <ListView fx:id="doneList" styleClass="task-list" VBox.vgrow="ALWAYS"/>
            </VBox>
        </HBox>
    </center>

    <!-- ===== BOTTOM: status bar ===== -->
    <bottom>
        <HBox styleClass="status-bar" spacing="10">
            <Label fx:id="statusLabel" text="Ready"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="progressLabel"/>
            <ProgressBar fx:id="progressBar" prefWidth="180"/>
        </HBox>
    </bottom>
</BorderPane>
